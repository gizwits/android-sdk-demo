# 后台地址包含代理前缀，例如 https://logs.example.com/api（不以 /updates/mobile 结尾）
APP_UPDATE_BASE_URL=
SDK_LOG_API_URL=
APP_UPDATE_ALLOW_HTTP=false
MOBILE_RELEASE_TOKEN=
# 必须使用与已安装正式版相同的签名；密码不会出现在命令行参数中
ANDROID_KEYSTORE=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
# 可省略，默认读取 local.properties
ANDROID_SDK_ROOT=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_NAME=
APP_ID=
COS_REGION=ap-guangzhou
COS_PREFIX=tools/mobile-apps
COS_SESSION_TOKEN=
